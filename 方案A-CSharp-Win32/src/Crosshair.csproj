<Project Sdk="Microsoft.NET.Sdk">

  <!--
    屏幕准星 —— 方案 A
    目标框架选 net48：依赖 Windows 自带的 .NET Framework 4.8 运行时，
    所以产物是「几百 KB 的单文件 exe」，而不是自包含的几十 MB。
    本机已确认存在 WindowsDesktop.App 10.0.12 与 .NET Framework 4.0/4.8。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>Crosshair</AssemblyName>
    <RootNamespace>CrosshairOverlay</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyTitle>屏幕准星</AssemblyTitle>
    <Product>Crosshair Overlay</Product>
    <Version>1.0.0</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

</Project>
